# Copy this file to .env.local and fill in your values.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (Project Settings → API Keys → service_role / secret).
# Required once RLS is enabled — API routes use it to bypass RLS. No NEXT_PUBLIC_ prefix!
SUPABASE_SERVICE_ROLE_KEY=

# ── Faculty passwords ─────────────────────────────────────────────────────────
# One env var per faculty. Key format: FACULTY_<CODE>_PASSWORD
# Change all of these before going live — do NOT use the default values.
FACULTY_COMMARTS_PASSWORD=
FACULTY_BUSINESS_PASSWORD=
FACULTY_ACCOUNT_PASSWORD=
FACULTY_LAW_PASSWORD=
FACULTY_HUSO_PASSWORD=
FACULTY_ECON_PASSWORD=
FACULTY_ENG_PASSWORD=
FACULTY_SCI_PASSWORD=
FACULTY_IT_PASSWORD=
FACULTY_ARCH_PASSWORD=
FACULTY_FINEART_PASSWORD=
FACULTY_DMCA_PASSWORD=
FACULTY_BUSEM_PASSWORD=

# ── Approver password ─────────────────────────────────────────────────────────
APPROVER_PASSWORD=

# ── Session signing ───────────────────────────────────────────────────────────
# Signs the httpOnly login cookie (bu_air_auth). Use a long random string,
# e.g. `openssl rand -hex 32`. Falls back to APPROVER_PASSWORD if unset.
# Changing it logs everyone out.
SESSION_SECRET=
